DATABASE_URL="postgresql://mbx:nopassword123!@10.100.10.5:5432/netman_dev?schema=public&connection_limit=5&pool_timeout=20&connect_timeout=10"

# MikroTik REST API Configuration (for cross-VLAN discovery)
MIKROTIK_HOST="10.5.80.1"
MIKROTIK_PORT=443
MIKROTIK_USER="it_rsia"
MIKROTIK_PASS="rsia2025"
MIKROTIK_SECURE=true

# Local JWT auth (non-SSO users)
AUTH_SECRET=change-me-to-a-long-random-string

# Listen port (dev server / local). Do not put this on APP_URL.
PORT=3001

# Public origin only — no port, no path.
# Local: http://localhost  → becomes http://localhost:PORT
# Prod:  https://netman.yourdomain.com
APP_URL=http://localhost

# SSO Identity Provider — @mbx92/nuxt-sso-client
# Installed from packages/mbx92-nuxt-sso-client-*.tgz (works on deploy without ../sso-login).
# Refresh tarball after SSO package updates: npm run sso:pack
# Redirect URI defaults to {APP_URL}/api/auth/sso/callback — override if needed.
SSO_ISSUER=http://localhost:3010
SSO_CLIENT_ID=netman-app
SSO_CLIENT_SECRET=your-client-secret-here
SSO_REDIRECT_URI=http://localhost:3001/api/auth/sso/callback
SSO_AUTO_PROVISION=true

# Default local admin (created by prisma seed)
# email: admin@netman.local
# password: admin123
