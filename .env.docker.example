# Database (overridden by docker-compose, but can be customized)
# DATABASE_URL=postgresql://postgres:postgres@db:5432/netman?schema=public

# MikroTik REST API Configuration
MIKROTIK_HOST=10.5.80.1
MIKROTIK_PORT=443
MIKROTIK_USER=your_user
MIKROTIK_PASS=your_password
MIKROTIK_SECURE=true

# Host publish port (container still listens on 3000)
PORT=3002

# Public origin only — no port, no path
APP_URL=https://netman.yourdomain.com

# SSO — @mbx92/nuxt-sso-client (tarball in packages/)
SSO_ISSUER=https://sso.yourdomain.com
SSO_CLIENT_ID=your_client_id
SSO_CLIENT_SECRET=your_client_secret
# SSO_REDIRECT_URI=https://netman.yourdomain.com/api/auth/sso/callback
SSO_AUTO_PROVISION=true
