// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// SITE / BUILDING MANAGEMENT
// ============================================

model Site {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  devices          Device[]
  mikrotikDevices  MikrotikDevice[]
  nasDevices       NAS[]
  ipRanges         IPRange[]
  hikvisionDevices HikvisionDevice[]
  proxmoxNodes     ProxmoxNode[]
}

// ============================================
// DEVICE MANAGEMENT
// ============================================

// Device Type Master Data
model DeviceType {
  id              String   @id @default(uuid())
  code            String   @unique // e.g., "SWITCH_MANAGED"
  name            String // e.g., "Managed Switch"
  icon            String? // Icon name for UI
  color           String? // Color hex for UI
  isNetworkDevice Boolean  @default(false) // Shows port management
  canHavePorts    Boolean  @default(false) // Can add ports
  topologyTier    Int      @default(2) // 0=router, 1=switch/AP, 2=end device
  sortOrder       Int      @default(0) // Display order in dropdowns
  isActive        Boolean  @default(true) // Soft delete
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  devices Device[]
}

model Device {
  id        String       @id @default(uuid())
  name      String
  typeCode  String // References DeviceType.code (e.g., "SWITCH_MANAGED")
  ip        String?
  mac       String?      @unique
  hostname  String?
  floor     String? // Floor number/name
  location  String?
  status    DeviceStatus @default(UNKNOWN)
  lastSeen  DateTime?
  owner     String?
  notes     String?
  wakeable  Boolean      @default(false)
  isManaged Boolean      @default(true) // For unmanaged switches (no ping)
  portCount Int? // Number of physical ports (for switches/routers)

  // MikroTik/Router API credentials (only for ROUTER type)
  apiPort     Int? // e.g., 8728
  apiUser     String?
  apiPass     String? // Should be encrypted in production
  apiVersion  String? // "v6" or "v7"
  isApiActive Boolean   @default(false)
  lastApiSync DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site relation
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  // Device type relation
  deviceType DeviceType? @relation(fields: [typeCode], references: [code])

  // Parent device relation (for VMs linked to hypervisor host)
  parentDeviceId String?
  parentDevice   Device?  @relation("DeviceHierarchy", fields: [parentDeviceId], references: [id], onDelete: SetNull)
  childDevices   Device[] @relation("DeviceHierarchy")

  ports          NetworkPort[]   @relation("DevicePorts") // Ports ON this device
  connectedPorts NetworkPort[]   @relation("PortConnections") // Ports this device is connected TO
  sessions       RemoteSession[]
  agent          Agent?

  @@index([typeCode])
  @@index([status])
  @@index([floor])
  @@index([location])
  @@index([siteId])
  @@index([parentDeviceId])
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  UNKNOWN
  MAINTENANCE
}

// ============================================
// NETWORK PORT TRACKING
// ============================================

model NetworkPort {
  id          String     @id @default(uuid())
  deviceId    String // Parent switch/router ID
  portName    String // e.g., "eth1", "ether1"
  portNumber  Int? // Physical port number (1, 2, 3...)
  vlan        String?
  speed       String?
  status      PortStatus @default(DOWN)
  macLearned  String[]
  description String?

  // Connected device assignment
  connectedDeviceId String? // Device connected to this port
  connectedDevice   Device? @relation("PortConnections", fields: [connectedDeviceId], references: [id], onDelete: SetNull)

  device Device @relation("DevicePorts", fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([deviceId, portName])
  @@index([connectedDeviceId])
}

enum PortStatus {
  UP
  DOWN
  DISABLED
}

// ============================================
// REMOTE ACCESS SESSION LOGGING
// ============================================

model RemoteSession {
  id         String         @id @default(uuid())
  user       String
  targetId   String
  protocol   RemoteProtocol
  startedAt  DateTime       @default(now())
  endedAt    DateTime?
  notes      String?
  target     Device         @relation(fields: [targetId], references: [id], onDelete: Cascade)
  viaAgentId String? // Set when this session was relayed through an Agent tunnel instead of a direct LAN dial
  viaAgent   Agent?         @relation(fields: [viaAgentId], references: [id], onDelete: SetNull)

  @@index([user])
  @@index([targetId])
  @@index([viaAgentId])
}

enum RemoteProtocol {
  SSH
  RDP
  VNC
  CONSOLE
  HTTP
}

// ============================================
// REMOTE AGENTS (Windows PC / Linux server)
// ============================================

// An installed netMan agent phoning home over an outbound WebSocket.
// Enables presence/telemetry monitoring and (via server/utils/agent-tunnel.ts,
// added in a later phase) SSH/RDP access to machines that aren't directly
// reachable on the LAN (NAT/firewall).
model Agent {
  id       String  @id @default(uuid())
  deviceId String? @unique
  device   Device? @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  platform     AgentPlatform
  hostname     String
  // Operator-set friendly display name — survives regardless of what the
  // machine reports as its hostname (which is often something auto-generated
  // and meaningless, e.g. "DESKTOP-7F3K2A1"). Falls back to hostname when unset.
  alias        String?
  osVersion    String?
  agentVersion String?

  // Enrollment (one-time token, hashed; consumed on successful enroll)
  enrollTokenHash String?
  enrollExpiresAt DateTime?
  enrolledAt      DateTime?

  // Long-lived reconnect credential, hashed — never stored/returned in plaintext after issuance
  authKeyHash String?

  status AgentStatus @default(PENDING)
  lastSeen DateTime?
  lastIp   String?

  // Latest telemetry snapshot — scalar columns for the summary list/badges,
  // lastMetrics for everything else (per-core CPU, I/O rates, partitions,
  // top processes, logged-in users). History lives in AgentMetricSample.
  lastCpuPercent  Float?
  lastMemPercent  Float?
  lastDiskPercent Float?
  lastUptimeSec   Int?
  lastMetrics     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      RemoteSession[]
  metricSamples AgentMetricSample[]

  @@index([status])
  @@index([deviceId])
}

// One row per heartbeat, retained for AGENT_METRIC_RETENTION_DAYS (default
// 14) by the agent-metrics-retention plugin — this is what backs the
// history charts on the agent detail page. Kept deliberately flat (not the
// full lastMetrics JSON) so range queries for charting don't need to parse
// JSON per row.
model AgentMetricSample {
  id      String @id @default(uuid())
  agentId String
  agent   Agent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  recordedAt DateTime @default(now())

  cpuPercent  Float
  memPercent  Float
  diskPercent Float
  swapPercent Float?

  netRxBytesPerSec     Float?
  netTxBytesPerSec     Float?
  diskReadBytesPerSec  Float?
  diskWriteBytesPerSec Float?

  loadAvg1 Float?

  @@index([agentId, recordedAt])
}

enum AgentPlatform {
  WINDOWS
  LINUX
  MACOS
}

enum AgentStatus {
  PENDING // enrollment token issued, agent has not connected yet
  ONLINE
  OFFLINE
}

// ============================================
// AUDIT TRAIL
// ============================================

model AuditLog {
  id        String   @id @default(uuid())
  actor     String
  action    String
  target    String
  details   Json?
  result    String
  createdAt DateTime @default(now())

  @@index([actor])
  @@index([action])
  @@index([createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id         String    @id @default(uuid())
  type       String
  severity   String    @default("warning")
  title      String
  message    String
  link       String?
  dedupeKey  String?
  routerId   String?
  mac        String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  resolvedAt DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())

  @@index([isRead])
  @@index([dedupeKey])
  @@index([routerId])
  @@index([createdAt])
}

// ============================================
// IP ADDRESS MANAGEMENT (IPAM)
// ============================================

model IPRange {
  id          String         @id @default(uuid())
  name        String
  network     String // e.g., "192.168.1.0/24"
  gateway     String?
  vlan        String?
  description String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  allocations IPAllocation[]

  // Site relation
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([siteId, network])
  @@index([siteId])
}

model IPAllocation {
  id        String         @id @default(uuid())
  rangeId   String
  ip        String
  mac       String?
  hostname  String?
  type      AllocationType
  createdAt DateTime       @default(now())
  range     IPRange        @relation(fields: [rangeId], references: [id], onDelete: Cascade)

  @@unique([rangeId, ip])
}

enum AllocationType {
  STATIC
  DHCP
  RESERVED
}

// ============================================
// MIKROTIK CREDENTIALS
// ============================================

model MikrotikDevice {
  id           String    @id @default(uuid())
  name         String
  host         String
  port         Int       @default(8728)
  username     String
  password     String // Should be encrypted in production
  apiVersion   String    @default("v6") // "v6" (API protocol) or "v7" (REST API)
  isActive     Boolean   @default(true)
  lastSync     DateTime?
  lastSnapshot Json? // Last captured ports/interfaces snapshot
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Site relation
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([host, port])
  @@index([siteId])
}

// ============================================
// NAS STORAGE (Manual Input)
// ============================================

model NAS {
  id        String  @id @default(uuid())
  name      String
  type      String? // Vendor: "QNAP", "Synology", "TrueNAS", etc.
  model     String? // Hardware model for chassis SVG: "RS1221+", "TS-873A", etc.
  location  String?
  ipAddress String?

  // NAS API credentials for live data capture
  username       String?
  password       String? // Stored encrypted or plaintext (never returned to frontend)
  lastCapturedAt DateTime?
  lastSnapshot   Json? // Last successful capture (volumes, disks, notes)

  // Storage info (captured from device or manual input)
  totalCapacityGB Float?
  usedCapacityGB  Float?
  bayCount        Int? // Number of drive bays

  // Additional info
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Site relation
  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  @@index([siteId])
}

// ============================================
// LOCAL APP USERS (non-SSO)
// ============================================

model AppUser {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String
  roleName     String   @default("admin")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

// ============================================
// HIKVISION INTEGRATION
// ============================================

model HikvisionDevice {
  id           String             @id @default(uuid())
  name         String
  host         String
  port         Int                @default(80)
  username     String
  password     String // Should be encrypted in production
  protocol     String             @default("http") // http or https
  deviceType   String             @default("NVR") // NVR, DVR, Camera, AccessControl
  model        String?
  serialNumber String?
  firmware     String?
  macAddress   String?
  isActive     Boolean            @default(true)
  lastSync     DateTime?
  lastSnapshot Json? // Last captured device info and channel list
  siteId       String?
  site         Site?              @relation(fields: [siteId], references: [id])
  channels     HikvisionChannel[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@unique([host, port])
  @@index([siteId])
}

model HikvisionChannel {
  id                String          @id @default(uuid())
  channelIndex      Int // Channel number on NVR/DVR (1-based)
  name              String?
  ipAddress         String?
  managePort        Int             @default(80)
  protocol          String? // HIKVISION, ONVIF
  macAddress        String?
  status            String          @default("UNKNOWN") // ONLINE, OFFLINE, UNKNOWN
  model             String?
  firmware          String?
  isActive          Boolean         @default(true)
  hikvisionDeviceId String
  device            HikvisionDevice @relation(fields: [hikvisionDeviceId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([hikvisionDeviceId, channelIndex])
  @@index([ipAddress])
  @@index([hikvisionDeviceId])
}

// ============================================
// PROXMOX VE INTEGRATION
// ============================================

model ProxmoxNode {
  id          String    @id @default(uuid())
  name        String
  host        String
  port        Int       @default(8006)
  realm       String    @default("pam")
  token       String // "user@realm!token-name=secret" (full PVEAPIToken value)
  isActive    Boolean   @default(true)
  lastSync    DateTime?
  lastSnapshot Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  siteId String?
  site   Site?   @relation(fields: [siteId], references: [id])

  @@unique([host, port])
  @@index([siteId])
}
