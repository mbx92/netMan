{"nodes": [{"id": "design_ibm_carbon_design_system", "label": "Carbon Design System", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_ibm_plex_sans", "label": "IBM Plex Sans Typeface", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Weight 300 is used for display sizes (42-76px) deliberately - it reads as quietly authoritative and differentiates IBM from competing enterprise brands that use bold 700-weight display type; the font is also free/open-source (SIL OFL) which makes it the easiest custom face on the list to substitute in implementation."}, {"id": "design_ibm_ibm_blue_accent", "label": "IBM Blue Single Accent Color", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "IBM Blue (#0f62fe) is treated as a scarce resource - the single chromatic brand accent reserved for links, primary CTAs, focus underlines, and the CTA banner - to keep visual hierarchy disciplined and avoid introducing a second brand color that would dilute the enterprise-gravitas voice."}, {"id": "design_ibm_flat_square_aesthetic", "label": "Flat Square-Corner Aesthetic", "file_type": "rationale", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every CTA, card, input, and container commits to 0px corner radius and 1px hairline borders instead of shadows, because rounded corners or drop shadows would make the brand read as a generic stylized SaaS product rather than engineered, old-world enterprise gravitas reframed for the cloud era."}, {"id": "design_ibm_four_pixel_grid_spacing", "label": "4px Base Spacing Grid", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All spacing tokens (4px-96px) are multiples of a 4px base unit so alignment stays predictable and precise across breakpoints - Carbon's signature grid discipline replaces large atmospheric whitespace with dense, precisely-aligned content."}, {"id": "design_ibm_button_primary", "label": "button-primary Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_button_secondary", "label": "button-secondary Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_button_tertiary", "label": "button-tertiary Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_button_ghost", "label": "button-ghost Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_button_danger", "label": "button-danger Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_feature_card", "label": "feature-card Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "design_ibm_product_card", "label": "product-card Component", "file_type": "concept", "source_file": "DESIGN-ibm.md", "source_location": null, "source_url": null, "captured_at": null, "author": 